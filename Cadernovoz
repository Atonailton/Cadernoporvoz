<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Caderno Via Voz</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      background: #fdfdfd;
    }
    .page {
      display: none;
      padding: 20px;
      height: 100vh;
      box-sizing: border-box;
    }
    .active {
      display: block;
    }
    .capa, .contracapa {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      background: linear-gradient(135deg, #5e60ce, #7400b8);
      color: white;
    }
    .capa h1 {
      font-size: 3em;
    }
    .contracapa textarea {
      width: 80%;
      height: 200px;
      margin-top: 20px;
      font-size: 1.2em;
    }
    .controls {
      position: fixed;
      bottom: 10px;
      left: 0;
      right: 0;
      display: flex;
      justify-content: center;
      gap: 10px;
    }
    button {
      padding: 10px 20px;
      font-size: 1em;
      cursor: pointer;
    }
    .header {
      margin-bottom: 10px;
    }
    .header input {
      margin-right: 10px;
      padding: 5px;
    }
    .linha {
      width: 100%;
      border-bottom: 1px solid #ccc;
      margin: 5px 0;
      min-height: 20px;
    }
  </style>
</head>
<body>

  <!-- Capa -->
  <div class="page capa active" id="capa">
    <h1>Caderno Via Voz</h1>
    <button onclick="goToPage('contracapa')">Ir para Agenda</button>
    <button onclick="goToPage('pagina1')">Começar a Escrever</button>
  </div>

  <!-- Contra capa / Agenda -->
  <div class="page contracapa" id="contracapa">
    <h2>Agenda</h2>
    <textarea placeholder="Escreva aqui seus compromissos..."></textarea>
    <button onclick="goToPage('capa')">Voltar à Capa</button>
    <button onclick="goToPage('pagina1')">Ir para Página 1</button>
  </div>

  <!-- Páginas do caderno -->
  <div id="paginasContainer"></div>

  <!-- Controles -->
  <div class="controls">
    <button onclick="prevPage()">Página Anterior</button>
    <button onclick="startDictation()">Falar</button>
    <button onclick="nextPage()">Próxima Página</button>
  </div>

  <script>
    let currentPage = 1;
    const totalPages = 500;

    const container = document.getElementById('paginasContainer');

    // Criar páginas dinamicamente
    for (let i = 1; i <= totalPages; i++) {
      const page = document.createElement('div');
      page.classList.add('page');
      page.id = 'pagina' + i;

      page.innerHTML = `
        <div class="header">
          Escola: <input type="text" placeholder="Nome da escola" /><br/>
          Data: <input type="date" /><br/>
          Matéria:
          <select>
            <option>Matemática</option>
            <option>Português</option>
            <option>Inglês</option>
          </select>
        </div>
        <div id="conteudo${i}">
          ${'<div class="linha"></div>'.repeat(30)}
        </div>
      `;
      container.appendChild(page);
    }

    function goToPage(id) {
      document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
      document.getElementById(id).classList.add('active');
    }

    function showCurrentPage() {
      goToPage('pagina' + currentPage);
    }

    function nextPage() {
      if (currentPage < totalPages) {
        currentPage++;
        showCurrentPage();
      }
    }

    function prevPage() {
      if (currentPage > 1) {
        currentPage--;
        showCurrentPage();
      }
    }

    function startDictation() {
      if (!('webkitSpeechRecognition' in window)) {
        alert("Seu navegador não suporta reconhecimento de voz.");
        return;
      }

      const recognition = new webkitSpeechRecognition();
      recognition.lang = 'pt-BR';
      recognition.continuous = false;
      recognition.interimResults = false;

      recognition.onresult = function(event) {
        const text = event.results[0][0].transcript;
        addTextToPage(text);
      };

      recognition.start();
    }

    function addTextToPage(text) {
      const contentDiv = document.getElementById('conteudo' + currentPage);
      const lines = contentDiv.querySelectorAll('.linha');
      for (let i = 0; i < lines.length; i++) {
        if (lines[i].textContent.trim() === '') {
          lines[i].textContent = text;
          break;
        }
      }
    }

    // Começa na capa
    showCurrentPage();
  </script>
</body>
</html>
